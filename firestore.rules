rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'admin', 'super_admin', 'product_manager', 'order_manager',
          'customer_support', 'review_manager', 'payment_manager', 'shipping_manager'
        ]
      );
    }

    // ─── Products (public read, admin write) ───────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Categories (public read, admin write) ─────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Coupons (public read for validation) ───────────────────
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Users & Customers ────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // ─── Reviews (Workflow: pending -> approved/rejected) ──────
    match /reviews/{reviewId} {
      // Only approved reviews are public; admins can view all (pending, approved, rejected)
      allow read: if (resource.data.status == 'approved') || isAdmin();
      // Authenticated users can submit a review with initial status 'pending'
      allow create: if request.auth != null && request.resource.data.status == 'pending';
      // Only admins can approve, reject, moderate, or delete reviews
      allow update, delete: if isAdmin();
    }

    // ─── Orders ───────────────────────────────────────────────
    match /orders/{orderId} {
      // Anyone authenticated can create an order (for themselves)
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'userId', 'items', 'subtotal', 'total',
                         'status', 'paymentMethod', 'shippingAddress',
                         'idempotencyKey'
                       ])
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.total > 0;

      // Users can only read their own orders; admins can read all
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Only admins can update or delete orders
      allow update, delete: if isAdmin();
    }

    // ─── Shipping & Logistics (Providers, Shipments, Logs) ────
    match /shipping_providers/{providerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /shipping_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ─── Payments & Admin Logs (Admin Only) ───────────────────
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ─── Admin Users, Roles & Store Settings (Admin Only) ─────
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }

    match /admin_roles/{roleId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true; // public store settings like fees
      allow write: if isAdmin();
    }

    // ─── Deny everything else by default ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
